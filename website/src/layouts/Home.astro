---
import '../styles/global.css';
import { copy } from '../lib/copy';
interface Props { language: 'en' | 'zh-CN' }
const { language } = Astro.props;
const t = copy[language];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;
const repo = 'https://github.com/Duskriver/nsh-music';
const canonical = new URL(asset(language === 'en' ? '' : 'zh-CN/'), Astro.site);
// Every mention of NSH in the copy links to it.
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const nsh = (text: string) => escape(text).replace(/\bNSH\b/g, '<a class="nsh-link" href="https://nsh.dev">NSH</a>');
// One line installs it: the shell script on macOS and Linux, PowerShell on
// Windows (both check the release's checksum).
const site = new URL(base || '/', Astro.site).href.replace(/\/$/, '');
const commands = [
  { id: 'unix', label: t.installUnix, command: `curl -fsSL ${site}/install.sh | bash`, href: `${repo}/blob/main/website/public/install.sh` },
  { id: 'windows', label: t.installWindows, command: `irm ${site}/install.ps1 | iex`, href: `${repo}/blob/main/website/public/install.ps1` },
];
---
<!doctype html>
<html lang={language} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.intro} />
    <meta name="theme-color" content="#0b0b0f" />
    <title>nsh-music — {t.eyebrow}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(asset(''), Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(asset('zh-CN/'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <meta property="og:title" content={`nsh-music — ${t.eyebrow}`} />
    <meta property="og:description" content={t.intro} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('screenshot.webp'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      let mode;
      try { mode = localStorage.getItem('nsh-music-mode'); } catch {}
      document.documentElement.dataset.theme = (mode === 'light' || mode === 'dark') ? mode : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    </script>
    <style>
      .quick-install{padding:0 0 40px}
      .install-requirements{margin:14px 0 0;font-size:12px;color:var(--muted)}
      .nsh-link{color:inherit;text-underline-offset:4px;text-decoration-color:color-mix(in srgb,currentColor 40%,transparent)}
      .nsh-link:hover{text-decoration-color:currentColor}
      .app-preview{margin:28px 0 0}
      .app-preview img{display:block;width:100%;height:auto;border:1px solid var(--subtle);border-radius:14px;background:var(--deep)}
      .feature-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1px;background:var(--subtle);border:1px solid var(--subtle);border-radius:14px;overflow:hidden}
      .feature-grid>div{background:var(--bg);padding:22px}
      .feature-grid h3{margin:0 0 6px;font-size:16px}
      .feature-grid p{margin:0;font-size:14px}
      .callout{border:1px solid var(--border);border-radius:14px;padding:24px;background:var(--deep)}
      /* Match the app’s primary action with a 36pt pill and a bold label. */
      .btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;border-radius:999px;padding:0 20px;font-weight:700;font-size:14px;line-height:1;text-decoration:none;transition:transform 180ms cubic-bezier(.22,1,.36,1),border-color 120ms ease-out,box-shadow 120ms ease-out}
      .btn::after{content:"";position:absolute;inset:0;border-radius:inherit;background:currentColor;opacity:0;transition:opacity 120ms ease-out;pointer-events:none}
      .btn:hover::after{opacity:.1}
      .btn:active{transform:scale(.97)}
      .btn:active::after{opacity:.15}
      .btn-primary{background:var(--text);color:var(--bg);box-shadow:0 1px 2px rgb(0 0 0/.2)}
      .btn-primary:hover{box-shadow:0 2px 6px rgb(0 0 0/.25)}
      @media(prefers-reduced-motion:reduce){.btn,.btn::after{transition:none}.btn:active{transform:none}}
      .hero .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}
      .platforms{margin:20px 0 0;padding:0;list-style:none;display:grid;gap:10px}
      .platforms li{font-size:14px;color:var(--secondary)}
      .platforms strong{color:var(--text);font-weight:600}
      .legal{flex-basis:100%;font-size:12px;color:var(--muted)}
    </style>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header><div class="shell nav-row">
      <a href={asset(language === 'en' ? '' : 'zh-CN/')} class="brand" aria-label="nsh-music"><img class="brand-mark" src={asset('favicon.svg')} alt="" />nsh-music</a>
      <nav aria-label={t.nav}>
        <a class="icon-control" href={repo} aria-label="GitHub" title="GitHub"><svg aria-hidden='true' fill='currentColor' viewBox='0 0 24 24' width='20' height='20'><path d='M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'/></svg></a>
        <a class="text-link" href={asset(language === 'en' ? 'zh-CN/' : '')}>{language === 'en' ? '中文' : 'EN'}</a>
        <button id="theme-toggle" class="icon-control" type="button" aria-label={t.darkMode} title={t.darkMode}><svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></button>
      </nav>
    </div></header>
    <main id="main" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow" set:html={nsh(t.eyebrow)} />
          <h1 id="hero-title">{t.title}</h1>
          <p class="intro" set:html={nsh(t.intro)} />
          <div class="actions">
            <a class="btn btn-primary" href={repo}>{t.getIt} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <figure class="app-preview">
          <img src={asset('screenshot.webp')} alt={t.homeScreenshot} fetchpriority="high" decoding="async" />
        </figure>
      </section>

      <section id="install" class="quick-install" aria-labelledby="install-title">
        <div class="install-heading"><h2 id="install-title">{t.install}</h2><div class="install-tabs" role="tablist" aria-label={t.installTabs}>
          {commands.map(({ id, label }, index) => <button id={`tab-${id}`} type="button" role="tab" aria-controls={`panel-${id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{label}</button>)}
        </div></div>
        {commands.map(({ id, command, href }, index) => <div id={`panel-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} tabindex="0" hidden={index !== 0}>
          <div class="command-block"><pre id={`command-${id}`}><code>{command}</code></pre><button type="button" class="copy-button" data-copy={`command-${id}`} data-copied={t.copied} data-error={t.copyFailed}>{t.copy}</button></div>
          <div class="install-meta"><p>{t.installNote}</p><a class="script-link" href={href}>{t.readScript} ↗</a></div>
        </div>)}
        <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
        <p class="install-requirements">{t.installRequirements}</p>
      </section>

      <section id="how" class="section">
        <div class="section-heading"><span class="index" aria-hidden="true">01 /</span><h2>{t.how}</h2><p>{t.howIntro}</p></div>
        <ol class="steps">{t.steps.map(([title, body], i) => <li><span class="step-number" aria-hidden="true">0{i + 1}</span><div><h3>{title}</h3><p set:html={nsh(body)} /></div><span class="step-symbol" aria-hidden="true">{['↓','→','↗'][i]}</span></li>)}</ol>
      </section>

      <section class="section">
        <div class="section-heading"><span class="index" aria-hidden="true">02 /</span><h2>{t.features}</h2><p set:html={nsh(t.featuresIntro)} /></div>
        <div class="feature-grid">{t.facts.map(([title, body]) => <div><h3>{title}</h3><p set:html={nsh(body)} /></div>)}</div>
        <figure class="app-preview">
          <img src={asset('screen-now-playing.webp')} alt={t.playingScreenshot} loading="lazy" decoding="async" />
        </figure>
        <ul class="platforms" aria-label={t.platformsLabel}>{t.platforms.map(([name, body]) => <li><strong>{name}</strong> — {body}</li>)}</ul>
      </section>

      <section class="section">
        <div class="section-heading"><span class="index" aria-hidden="true">03 /</span><h2>{t.compliance}</h2></div>
        <div class="callout">
          <p>{t.complianceBody}</p>
        </div>
      </section>

      <section class="section">
        <div class="section-heading"><span class="index" aria-hidden="true">04 /</span><h2 set:html={nsh(t.nsh)} /><p set:html={nsh(t.nshBody)} /></div>
        <p class="foundation"><a class="text-link" href="https://nsh.dev">nsh.dev ↗</a></p>
      </section>

    </main>
    <footer><div class="shell"><span>nsh-music · {t.footer}</span><span>{t.built} <a class="text-link" href="https://nsh.dev">NSH</a> · <a class="text-link" href={repo}>{t.source}</a></span><p class="legal">{t.trademark}</p></div></footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('#theme-toggle');
      function apply(light: boolean) {
        root.dataset.theme = light ? 'light' : 'dark';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#fcfbfa' : '#0b0b0f');
      }
      // Install: the tabs (arrow keys move between them) and Copy.
      const tabs = [...document.querySelectorAll<HTMLElement>('.install-tabs [role=tab]')];
      function select(tab: HTMLElement) {
        for (const other of tabs) {
          const on = other === tab;
          other.setAttribute('aria-selected', String(on));
          other.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !on;
        }
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
      // Windows visitors start on the PowerShell line.
      if (/Windows/.test(navigator.userAgent)) { const win = tabs.find((t) => t.id === 'tab-windows'); if (win) select(win); }
      const status = document.getElementById('copy-status');
      for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-button')) {
        const label = button.textContent;
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy ?? '')?.textContent ?? '';
          let done = true;
          try { await navigator.clipboard.writeText(text); } catch { done = false; }
          button.textContent = (done ? button.dataset.copied : button.dataset.error) ?? '';
          if (status) status.textContent = button.textContent;
          setTimeout(() => { button.textContent = label; }, 1600);
        });
      }
      toggle?.addEventListener('click', () => {
        const light = root.dataset.theme !== 'light';
        try { localStorage.setItem('nsh-music-mode', light ? 'light' : 'dark'); } catch {}
        apply(light);
      });
    </script>
  </body>
</html>
